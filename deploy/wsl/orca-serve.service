# Orca's headless server for this distro, a systemd user unit. The port is this distro's own: distros
# share one network, 6768 and 6769 belong to the old hosts, and mirrored networking also shares Windows'
# ports, which is why 6770 refused with no Linux listener on it. Same limits as the old host's unit:
# northstar@b384d298d217d3f8d9aa83356994629536a34795:docs/handoff/workstation/phase-1-base.md, section 7.
[Unit]
Description=Sextant Orca server
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/orca-ide serve --supervise --no-pairing --port 6771
Environment=ORCA_TERMINAL_MEMORY_MAX=16G
Environment=ORCA_TERMINAL_MEMORY_SWAP_MAX=0
Restart=on-failure
RestartSec=5
KillMode=process
StandardOutput=null
StandardError=null

[Install]
WantedBy=default.target
