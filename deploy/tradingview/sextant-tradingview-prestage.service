[Unit]
Description=Sextant TradingView display unit producer (PRE, RTH and POST)
Documentation=https://github.com/seathatflowsinourveins/sextant/blob/main/deploy/tradingview/README.md
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/sextant
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin PYTHONUNBUFFERED=1
# Slot 2 paper data credentials, injected for this command only; REST bars, no stream, no order.
# The three bounds and the memory limit have no default authority; install.sh takes them as arguments.
ExecStart=/usr/bin/bash %h/sextant/scripts/with-keys.sh --strict -k ALPACA_PAPER_2_API_KEY -k ALPACA_PAPER_2_SECRET_KEY -- %h/.local/bin/uv run --frozen python -m sextant.tradingview.prestage --research-dir %h/sextant-data/tradingview-prestage/unit --nasdaq-listed %h/sextant-data/tradingview-prestage/nasdaqlisted.txt --other-listed %h/sextant-data/tradingview-prestage/otherlisted.txt --symbol-map %h/sextant-data/tradingview-prestage/symbol_map.json --gap-bound @GAP_BOUND@ --rvol-bound @RVOL_BOUND@ --bounds-max-age-s @BOUNDS_MAX_AGE_S@
Restart=on-failure
MemoryMax=@PRODUCER_MEMORY_MAX@
MemorySwapMax=0

[Install]
WantedBy=default.target
