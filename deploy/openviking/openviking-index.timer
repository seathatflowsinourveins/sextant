# git-maintenance@hourly.timer's shape: hourly, Persistent, 20 minutes after git's prefetch at the hour,
# so each run reads the main it just fetched. Values: parameters.json rows openviking_index_*, UNCALIBRATED.
[Unit]
Description=Sextant research index follows main

[Timer]
OnCalendar=*-*-* *:20:00
Persistent=true

[Install]
WantedBy=timers.target
