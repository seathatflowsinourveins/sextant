[Unit]
Description=Sextant morning calibration inputs and C baselines
Documentation=https://github.com/seathatflowsinourveins/sextant/blob/main/deploy/calibration/README.md
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/sextant
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Slot 2 paper data credentials, injected for this command only; no trading client.
ExecStart=/usr/bin/bash %h/sextant/scripts/with-keys.sh --strict -k ALPACA_PAPER_2_API_KEY:APCA_API_KEY_ID -k ALPACA_PAPER_2_SECRET_KEY:APCA_API_SECRET_KEY -- /usr/bin/bash %h/sextant/scripts/calibration-data.sh %h/sextant-data/calibration
ExecStartPost=/usr/bin/bash %h/sextant/scripts/with-keys.sh --strict -k ALPACA_PAPER_2_API_KEY:APCA_API_KEY_ID -k ALPACA_PAPER_2_SECRET_KEY:APCA_API_SECRET_KEY -- /usr/bin/bash %h/sextant/scripts/ranking-inputs.sh %h/sextant-data/calibration %h/sextant-data/tradingview-prestage
TimeoutStartSec=infinity
MemoryMax=2G
MemorySwapMax=0
