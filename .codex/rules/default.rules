prefix_rule(
    pattern = [["cmd", "cmd.exe"], ["/c", "/k"], ["wsl", "wsl.exe", "set"]],
    decision = "forbidden",
    canonical_matching = True,
    justification = "AGENTS.md Start: never run wsl.exe; --shutdown or --terminate would stop other distros.",
    match = ["cmd /c wsl"],
    not_match = ["sextant-no-such-program /c wsl"],
)

prefix_rule(
    pattern = [["powershell", "powershell.exe", "pwsh", "pwsh.exe"], ["-c", "-Command"], ["wsl", "wsl.exe"]],
    decision = "forbidden",
    canonical_matching = True,
    justification = "AGENTS.md Start: never run wsl.exe; --shutdown or --terminate would stop other distros.",
    match = ["powershell -c wsl"],
    not_match = ["sextant-no-such-program -c wsl"],
)

prefix_rule(
    pattern = [["powershell", "powershell.exe", "pwsh", "pwsh.exe"], ["-c", "-Command"], ["Get-ChildItem", "gci", "Get-Item", "dir", "ls"]],
